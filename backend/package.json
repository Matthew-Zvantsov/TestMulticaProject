{
	"name": "backend",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "Todo list backend REST API",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"migrate": "tsx src/db/migrate.ts"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.1",
		"@types/pg": "^8.11.10",
		"@types/supertest": "^6.0.2",
		"pg-mem": "^3.0.4",
		"supertest": "^7.0.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
